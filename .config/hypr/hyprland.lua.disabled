---@module 'hl'

-- ML4W Hyprland Lua Configuration

-- Monitor
require("conf.monitor")

-- Cursor
require("conf.cursor")
require("conf.cursor_rules")

-- Environment
require("conf.environment")

-- Keyboard
require("conf.keyboard")

-- Load pywal color file
require("colors")

local color8 = "local_var_on_primary_fixed"
local color11 = "local_var_on_surface"

-- Autostart
require("conf.autostart")

-- Load configuration files
require("conf.window")
require("conf.decoration")
require("conf.layout")
require("conf.workspace")
require("conf.misc")
require("conf.keybinding")
require("conf.windowrule")

-- Animation
require("conf.animation")

-- ML4W Configuration
require("conf.ml4w")

-- Custom
require("conf.custom")

-- Plugins
require("conf.plugins")

-- Autostart
hl.on("hyprland.start", function()
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
    hl.exec_cmd("sudo input-remapper-service")
    hl.exec_cmd("input-remapper-control --command autoload")
    hl.exec_cmd("sudo /sbin/openrgb --noautoconnect -d 4 -m direct -c 0000FF")
    hl.exec_cmd("~/.config/hypr/scripts/set-plugins.sh &")
end)
